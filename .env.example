# Copy to .env and adjust. .env is git-ignored.
DATABASE_URL=postgres://steamlib:steamlib@localhost:5432/steamlib?sslmode=disable
PORT=8080
# Only this computer can reach the app. Set to 0.0.0.0 to allow other devices
# on your network (read "Remote access" in the README first).
LISTEN_HOST=127.0.0.1

# Steam Web API key: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
# The address you open the app at. Steam sends you back here after sign-in.
# With the Vite frontend (make web) that's port 5173.
PUBLIC_URL=http://localhost:5173
# Every log line also goes here (relative to backend/). Use - for console only.
LOG_FILE=logs/api-calls.txt
