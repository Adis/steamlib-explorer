<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installer": the Inno Setup installer.
     The release workflow uploads it as a zip and passes the release version. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="steamlib-explorer_${version}_windows_setup.exe" product-name="Steamlib Explorer" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
